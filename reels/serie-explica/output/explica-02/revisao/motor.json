{
 "duracao": 84.259,
 "apoios": [
  {
   "cap": 0,
   "i": 1,
   "texto": "Dá pra nunca mais passar por isso.",
   "entra": 4.311,
   "inteira_de": 4.651,
   "ate": 7.772
  },
  {
   "cap": 1,
   "i": 1,
   "texto": "Dois hóspedes e um chalé só.",
   "entra": 8.072,
   "inteira_de": 8.411999999999999,
   "ate": 10.751
  },
  {
   "cap": 1,
   "i": 2,
   "texto": "Uma veio pelo WhatsApp, a outra pelo site.",
   "entra": 10.751,
   "inteira_de": 11.091,
   "ate": 13.572
  },
  {
   "cap": 1,
   "i": 3,
   "texto": "E as duas estavam confirmadas.",
   "entra": 13.572,
   "inteira_de": 13.911999999999999,
   "ate": 15.992
  },
  {
   "cap": 2,
   "i": 1,
   "texto": "O problema não foi o hóspede.",
   "entra": 16.292,
   "inteira_de": 16.632,
   "ate": 18.251
  },
  {
   "cap": 2,
   "i": 2,
   "texto": "Foi a agenda, espalhada em três lugares.",
   "entra": 18.251,
   "inteira_de": 18.591,
   "ate": 23.58
  },
  {
   "cap": 2,
   "i": 3,
   "texto": "Um não sabia o que o outro vendeu.",
   "entra": 23.58,
   "inteira_de": 23.919999999999998,
   "ate": 26.358
  },
  {
   "cap": 3,
   "i": 1,
   "texto": "Passo 1: uma agenda só.",
   "entra": 26.658,
   "inteira_de": 26.998,
   "ate": 28.578
  },
  {
   "cap": 3,
   "i": 2,
   "texto": "Venha de onde vier, a reserva entra nela.",
   "entra": 28.578,
   "inteira_de": 28.918,
   "ate": 31.334
  },
  {
   "cap": 3,
   "i": 3,
   "texto": "É ela que diz se tem vaga.",
   "entra": 31.334,
   "inteira_de": 31.674,
   "ate": 33.844
  },
  {
   "cap": 4,
   "i": 1,
   "texto": "Passo 2: a pré-reserva tem prazo.",
   "entra": 34.144,
   "inteira_de": 34.484,
   "ate": 36.064
  },
  {
   "cap": 4,
   "i": 2,
   "texto": "A data fica segura por 24 horas.",
   "entra": 36.064,
   "inteira_de": 36.404,
   "ate": 38.971
  },
  {
   "cap": 4,
   "i": 3,
   "texto": "Pagou o sinal: confirmada.",
   "entra": 38.971,
   "inteira_de": 39.311,
   "ate": 41.235
  },
  {
   "cap": 4,
   "i": 4,
   "texto": "Não pagou: a data fica livre.",
   "entra": 41.235,
   "inteira_de": 41.575,
   "ate": 44.036
  },
  {
   "cap": 5,
   "i": 1,
   "texto": "Passo 3: vendeu num lugar, fecha em todos.",
   "entra": 44.336,
   "inteira_de": 44.676,
   "ate": 47.921
  },
  {
   "cap": 5,
   "i": 2,
   "texto": "Confirmou, a data fecha em todos os canais.",
   "entra": 47.921,
   "inteira_de": 48.261,
   "ate": 52.544
  },
  {
   "cap": 6,
   "i": 1,
   "texto": "Passo 4: antes do “tem sim”, olhe a agenda.",
   "entra": 52.844,
   "inteira_de": 53.184000000000005,
   "ate": 56.963
  },
  {
   "cap": 6,
   "i": 2,
   "texto": "Nunca de memória.",
   "entra": 56.963,
   "inteira_de": 57.303000000000004,
   "ate": 58.883
  },
  {
   "cap": 6,
   "i": 3,
   "texto": "10 segundos evitam o pior sábado do ano.",
   "entra": 58.883,
   "inteira_de": 59.223000000000006,
   "ate": 62.109
  },
  {
   "cap": 7,
   "i": 1,
   "texto": "A data segura não é a reserva feita.",
   "entra": 62.409,
   "inteira_de": 62.749,
   "ate": 65.204
  },
  {
   "cap": 7,
   "i": 2,
   "texto": "Reserva é quando o sinal entrou.",
   "entra": 65.204,
   "inteira_de": 65.544,
   "ate": 67.912
  },
  {
   "cap": 8,
   "i": 1,
   "texto": "Um passo de cada vez, nessa ordem.",
   "entra": 68.212,
   "inteira_de": 68.552,
   "ate": 75.259
  },
  {
   "cap": 9,
   "i": 1,
   "texto": "Pra ter à mão antes do próximo “tem vaga?”.",
   "entra": 75.559,
   "inteira_de": 75.899,
   "ate": 80.909
  }
 ],
