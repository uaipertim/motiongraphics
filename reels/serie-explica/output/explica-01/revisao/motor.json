{
 "duracao": 76.892,
 "apoios": [
  {
   "cap": 0,
   "i": 1,
   "texto": "Elas decidem se a pousada ganha ou perde.",
   "entra": 3.08,
   "inteira_de": 3.42,
   "ate": 7.9
  },
  {
   "cap": 1,
   "i": 1,
   "texto": "Uma frase que já derrubou muito caixa.",
   "entra": 8.2,
   "inteira_de": 8.54,
   "ate": 11.025
  },
  {
   "cap": 1,
   "i": 2,
   "texto": "Sem valor, sem data, sem registro.",
   "entra": 11.025,
   "inteira_de": 11.365,
   "ate": 13.445
  },
  {
   "cap": 2,
   "i": 1,
   "texto": "Sinal, saldo e crédito: cada um no seu encaixe.",
   "entra": 13.745,
   "inteira_de": 14.084999999999999,
   "ate": 16.094
  },
  {
   "cap": 2,
   "i": 2,
   "texto": "Basta uma ficar solta pra dar prejuízo.",
   "entra": 16.094,
   "inteira_de": 16.434,
   "ate": 19.045
  },
  {
   "cap": 3,
   "i": 1,
   "texto": "A primeira das três palavras.",
   "entra": 19.345,
   "inteira_de": 19.685,
   "ate": 21.265
  },
  {
   "cap": 3,
   "i": 2,
   "texto": "É o valor pago pra garantir a data.",
   "entra": 21.265,
   "inteira_de": 21.605,
   "ate": 23.185
  },
  {
   "cap": 3,
   "i": 3,
   "texto": "Sem sinal, a data ainda não é sua.",
   "entra": 23.185,
   "inteira_de": 23.525,
   "ate": 25.105
  },
  {
   "cap": 3,
   "i": 4,
   "texto": "É só uma promessa.",
   "entra": 25.105,
   "inteira_de": 25.445,
   "ate": 27.525
  },
  {
   "cap": 4,
   "i": 1,
   "texto": "A segunda palavra.",
   "entra": 27.825,
   "inteira_de": 28.165,
   "ate": 29.745
  },
  {
   "cap": 4,
   "i": 2,
   "texto": "Saldo é o que ainda falta pagar.",
   "entra": 29.745,
   "inteira_de": 30.085,
   "ate": 31.665
  },
  {
   "cap": 4,
   "i": 3,
   "texto": "Ele muda com consumo e desconto.",
   "entra": 31.665,
   "inteira_de": 32.005,
   "ate": 34.667
  },
  {
   "cap": 4,
   "i": 4,
   "texto": "Sem acompanhar, a cobrança sai errada.",
   "entra": 34.667,
   "inteira_de": 35.007000000000005,
   "ate": 38.582
  },
  {
   "cap": 5,
   "i": 1,
   "texto": "A terceira palavra.",
   "entra": 38.882,
   "inteira_de": 39.222,
   "ate": 40.802
  },
  {
   "cap": 5,
   "i": 2,
   "texto": "O hóspede cancelou a reserva.",
   "entra": 40.802,
   "inteira_de": 41.142,
   "ate": 42.722
  },
  {
   "cap": 5,
   "i": 3,
   "texto": "O sinal não some nem volta pro bolso.",
   "entra": 42.722,
   "inteira_de": 43.062000000000005,
   "ate": 44.642
  },
  {
   "cap": 5,
   "i": 4,
   "texto": "Sempre com a regra combinada antes.",
   "entra": 44.642,
   "inteira_de": 44.982000000000006,
   "ate": 48.008
  },
  {
   "cap": 6,
   "i": 1,
   "texto": "Sinal é parte do pagamento, não abatimento.",
   "entra": 48.308,
   "inteira_de": 48.648,
   "ate": 51.249
  },
  {
   "cap": 6,
   "i": 2,
   "texto": "Crédito vira outra data, não dinheiro de volta.",
   "entra": 51.249,
   "inteira_de": 51.589000000000006,
   "ate": 53.991
  },
  {
   "cap": 7,
   "i": 1,
   "texto": "Três perguntas, sempre nessa ordem.",
   "entra": 54.291,
   "inteira_de": 54.631,
   "ate": 57.302
  },
  {
   "cap": 7,
   "i": 2,
   "texto": "O que entrou, o que consumiu, o que falta.",
   "entra": 57.302,
   "inteira_de": 57.642,
   "ate": 61.321
  },
  {
   "cap": 8,
   "i": 1,
   "texto": "Uma frase pra cada palavra.",
   "entra": 61.621,
   "inteira_de": 61.961000000000006,
   "ate": 63.552
  },
  {
   "cap": 8,
   "i": 2,
   "texto": "Fácil de lembrar no balcão.",
   "entra": 63.552,
   "inteira_de": 63.892,
   "ate": 65.472
  },
  {
   "cap": 8,
   "i": 3,
   "texto": "Cola perto do caixa.",
   "entra": 65.472,
   "inteira_de": 65.812,
   "ate": 67.892
  },
  {
   "cap": 9,
   "i": 1,
   "texto": "Pra ter à mão no próximo check-out.",
   "entra": 68.192,
   "inteira_de": 68.532,
   "ate": 73.542
  }
 ],
